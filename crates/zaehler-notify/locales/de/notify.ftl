# Texte der E-Mails (SPEC_NTF_EMAIL). Platzhalter sind bereits formatiert.

reminder-subject = Ablesung fällig: { $household }
reminder-intro = Im Haushalt „{ $household }“ sind folgende Ablesungen fällig:
reminder-due = { $meter }: fällig am { $date }
reminder-overdue = { $meter }: überfällig seit { $date }
reminder-capture = Erfassen: { $link }

alarm-subject = Auffälliger Verbrauch: { $meter }
alarm-intro = Im Haushalt „{ $household }“ weicht der Verbrauch der Messstelle „{ $meter }“ deutlich von der Erwartung ab.
alarm-period = Zeitraum: { $from } bis { $until }
alarm-consumption = Verbrauch: { $consumption } { $unit }
alarm-expected = Erwartet: { $lower } bis { $upper } { $unit }
alarm-details = Details: { $link }

invite-subject = Einladung in den Haushalt „{ $household }“
invite-intro = { $inviter } lädt in den Haushalt „{ $household }“ ein (Rolle: { $role }).
invite-accept = Einladung annehmen: { $link }
invite-expires = Der Link ist bis { $date } gültig und kann nur einmal verwendet werden.

role-owner = Eigentümer
role-member = Mitglied
role-viewer = Lesen

footer-settings = Benachrichtigungen einstellen: { $link }
footer-sender = Diese Nachricht wurde automatisch von Zähler versendet.
