# Kopieren nach .env und anpassen. Alle Schlüssel: ZAEHLER_<SEKTION>__<FELD>
# Gelesen von `cargo run`/`zaehler` (Arbeitsverzeichnis) und docker compose.

# AI (OpenRouter); ohne diese Werte ist die Foto-Erkennung deaktiviert
ZAEHLER_AI__API_KEY=sk-or-...
ZAEHLER_AI__MODEL=google/gemini-2.5-flash

# Anmeldung: entweder OIDC oder (nur lokal) Entwicklungs-Login
# (docker compose: Default true)
# ZAEHLER_AUTH__DEV_LOGIN=true

# Adresse (docker compose: nur PUBLIC_URL, der Container lauscht fest auf 8080)
# ZAEHLER_SERVER__LISTEN=0.0.0.0:8080
# ZAEHLER_SERVER__PUBLIC_URL=http://localhost:8080

# OIDC (Keycloak, Authentik, Entra ID, …)
# ZAEHLER_OIDC__ISSUER_URL=https://auth.example.com/realms/home
# ZAEHLER_OIDC__CLIENT_ID=zaehler
# ZAEHLER_OIDC__CLIENT_SECRET=...

# E-Mail
# ZAEHLER_NOTIFY__SMTP__HOST=smtp.example.com
# ZAEHLER_NOTIFY__SMTP__USERNAME=...
# ZAEHLER_NOTIFY__SMTP__PASSWORD=...
# ZAEHLER_NOTIFY__SMTP__FROM=zaehler@example.com
# ZAEHLER_NOTIFY__SMTP__SECURITY=starttls

# PostgreSQL-Variante (compose.postgres.yaml)
# POSTGRES_PASSWORD=change-me
